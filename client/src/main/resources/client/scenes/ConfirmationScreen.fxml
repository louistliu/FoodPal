<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.ConfirmationScreenCtrl">
    <children>
        <Label fx:id="warningLabel" text="Are you sure you want to delete this?" wrapText="true" />
        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="yesButton" onAction="#handleYes" text="Yes" />
            <Button fx:id="noButton" onAction="#handleNo" text="No" />
        </HBox>
    </children>
</VBox>
